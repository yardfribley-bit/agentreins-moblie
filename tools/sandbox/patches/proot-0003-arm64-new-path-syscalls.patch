Teach PRoot the arm64 numbers of the path-taking syscalls added after
statx, so none of them reaches the kernel with an untranslated path.
The arm64 table stopped at statx (291): faccessat2 (439) was handled by
the translation code and listed in the seccomp filter, but its number
mapped to nothing, so it ran on the host path whenever the platform
let it through.  faccessat2 and fchmodat2 are now translated like
faccessat/fchmodat; execveat, openat2, io_uring_setup, the mount API
and the *xattrat/file_*attr calls are answered with -ENOSYS, which
their callers handle by falling back to the older syscalls.  Also fix
the off-by-one bound check of the number lookup.

--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -431,6 +431,45 @@
 		status = translate_path2(tracee, dirfd, path, SYSARG_2, REGULAR);
 		break;
 
+	case PR_fchmodat2:
+		dirfd = peek_reg(tracee, CURRENT, SYSARG_1);
+		flags = peek_reg(tracee, CURRENT, SYSARG_4);
+
+		status = get_sysarg_path(tracee, path, SYSARG_2);
+		if (status < 0)
+			break;
+
+		if ((flags & AT_SYMLINK_NOFOLLOW) != 0)
+			status = translate_path2(tracee, dirfd, path, SYSARG_2, SYMLINK);
+		else
+			status = translate_path2(tracee, dirfd, path, SYSARG_2, REGULAR);
+		break;
+
+	/* Newer syscalls that reach paths without going through the
+	 * translation above: execveat would skip the execve handling,
+	 * openat2's RESOLVE_* rules apply to the guest's view of the
+	 * tree, io_uring runs path operations with no syscall at all,
+	 * and the mount API and *xattrat/file_*attr calls aren't
+	 * translated.  Letting them through would act on host paths, so
+	 * answer "not implemented": callers fall back to the older
+	 * syscalls handled here.  */
+	case PR_execveat:
+	case PR_io_uring_setup:
+	case PR_open_tree:
+	case PR_move_mount:
+	case PR_fspick:
+	case PR_openat2:
+	case PR_mount_setattr:
+	case PR_setxattrat:
+	case PR_getxattrat:
+	case PR_listxattrat:
+	case PR_removexattrat:
+	case PR_open_tree_attr:
+	case PR_file_getattr:
+	case PR_file_setattr:
+		status = -ENOSYS;
+		break;
+
 	case PR_inotify_add_watch:
 		flags = peek_reg(tracee, CURRENT, SYSARG_3);
 
