+#include <fcntl.h>      /* AT_EACCESS, */
+#include <sys/uio.h>    /* struct iovec, */
+#if defined(ARCH_ARM64)
+#include <linux/elf.h>  /* NT_PRSTATUS, */
+#endif
 
+#ifndef SYS_SECCOMP
+#define SYS_SECCOMP 1
+#endif
